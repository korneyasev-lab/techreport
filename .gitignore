# 1. Системные файлы IDE PyCharm
# Эти файлы хранят настройки вашего личного окружения и не нужны другим разработчикам.
.idea/

# 2. Папка с генерируемыми отчётами
# В репозитории должен храниться код, который создаёт отчёты, а не сами отчёты.
reports/

# 3. Стандартные файлы и папки для Python-проектов
# Кэш, виртуальные окружения и т.д.
__pycache__/
venv/
env/
*.pyc

# 4. Папки сборки PyInstaller
# Временные файлы и скомпилированный .exe
build/
dist/
*.spec
!build.spec